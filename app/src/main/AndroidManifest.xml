<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Stealth Mode permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required by OsmDroid tile downloader to check connectivity before fetching tiles -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Live streaming + evidence capture -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nightagent"
        android:enableOnBackInvokedCallback="true">
        
        <!-- Google Play Services -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <!--
            Google Maps API Key — REQUIRED for the Map screen.
            Steps to get your key:
              1. Go to https://console.cloud.google.com/
              2. Create a project → Enable "Maps SDK for Android"
              3. Credentials → Create API Key → restrict to this app's package name
              4. Replace the value below with your key.
            Until you add a real key, the Map tab will show an OSMDroid map
            (no API key needed) and this entry is ignored.
        -->
        <!-- <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_REAL_KEY_HERE" /> -->

        <!-- Stealth Mode: Fake Calculator (LAUNCHER disguise) -->
        <activity
            android:name=".ui.stealth.CalculatorActivity"
            android:exported="true"
            android:label="Calculator"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nightagent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Main Activity — exported so FCM notification deep-links can open it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nightagent"/>

        <!-- Power Button SOS Receiver -->
        <receiver
            android:name=".sos.PowerButtonReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON"/>
                <action android:name="android.intent.action.SCREEN_OFF"/>
            </intent-filter>
        </receiver>

        <!-- FCM Service -->
        <service
            android:name=".firebase.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Fake Call Activity (Full screen incoming call UI) -->
        <activity
            android:name=".ui.activities.FakeCallActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true" />

        <!-- Stealth Mode: Background detection service (screen on/off → power button SOS) -->
        <service
            android:name=".stealth.StealthDetectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Stealth Mode: Silent audio recording service -->
        <service
            android:name=".stealth.AudioRecordingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Feature 1: Live audio streaming (WebRTC) -->
        <service
            android:name=".streaming.AudioStreamingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Feature 2: Automatic evidence capture (audio + GPS only — camera runs in UI layer) -->
        <service
            android:name=".evidence.EvidenceCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|location" />

        <!-- WorkManager — required for background voice upload -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
